{
  "name": "overtime-tracker",
  "version": "1.0.15",
  "description": "智能加班统计、考勤分析与 AI 月报生成平台（Next.js + Prisma + PostgreSQL）",
  "license": "MIT",
  "author": "Durun Song <https://github.com/durunsong>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/durunsong/overtime-tracker.git"
  },
  "homepage": "https://github.com/durunsong/overtime-tracker#readme",
  "bugs": {
    "url": "https://github.com/durunsong/overtime-tracker/issues"
  },
  "keywords": [
    "overtime",
    "attendance",
    "timesheet",
    "nextjs",
    "prisma",
    "postgresql",
    "ai",
    "china-holiday",
    "workforce-analytics",
    "overtime-tracker",
    "overtime-tracker-ai",
    "加班统计",
    "考勤分析",
    "Excel导入",
    "月报生成",
    "AI总结",
    "Overtime Tracker",
    "Overtime Tracker AI",
    "Overtime Tracker Excel导入",
    "Overtime Tracker月报生成",
    "Overtime Tracker AI总结"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_config_user_agent||'')){console.error('\\n请使用 pnpm 安装依赖：pnpm install\\n');process.exit(1)}\"",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest",
    "calendar:sync": "tsx scripts/sync-china-holidays.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-slot": "^1.2.4",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
